NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production guard:
# - Vercel production deploys are detected with VERCEL_ENV=production.
# - For local production-like checks, set NATIVE_MINUTE_PRODUCTION_GUARD=1.
# - Production preflight expects VOICE_PROVIDER=elevenlabs, TRANSCRIPTION_PROVIDER=openai,
#   and PRONUNCIATION_PROVIDER=azure. It requires SCRIPT_GENERATION_PROVIDER=openai
#   only when NATIVE_MINUTE_ENABLE_AI_SCRIPT_GENERATION is enabled.
# - OPENAI_API_KEY remains required for transcription while generation is disabled.
# - Before DB-backed quota enforcement, production launch mode must be private_beta
#   or small_cohort. public_free is intentionally blocked by production preflight.
NATIVE_MINUTE_ENV=
NATIVE_MINUTE_PRODUCTION_GUARD=
NATIVE_MINUTE_LAUNCH_MODE=
# Beta provider quota is OFF until the DB migration and all policy values are ready.
# No allowance or period is chosen by this template.
NATIVE_MINUTE_ENABLE_BETA_QUOTA_ENFORCEMENT=0
NATIVE_MINUTE_QUOTA_REFERENCE_AUDIO_PER_USER_LIMIT=
NATIVE_MINUTE_QUOTA_REFERENCE_AUDIO_GLOBAL_LIMIT=
NATIVE_MINUTE_QUOTA_REFERENCE_AUDIO_PERIOD=
NATIVE_MINUTE_QUOTA_EVALUATION_PER_USER_LIMIT=
NATIVE_MINUTE_QUOTA_EVALUATION_GLOBAL_LIMIT=
NATIVE_MINUTE_QUOTA_EVALUATION_PERIOD=
NATIVE_MINUTE_QUOTA_VOICE_CREATION_PER_USER_LIMIT=
NATIVE_MINUTE_QUOTA_VOICE_CREATION_GLOBAL_LIMIT=
NATIVE_MINUTE_QUOTA_VOICE_CREATION_PERIOD=
# Emergency cost kill switches. Set to 1 only when pausing that paid surface.
NATIVE_MINUTE_DISABLE_OPENAI=
NATIVE_MINUTE_DISABLE_AZURE=
NATIVE_MINUTE_DISABLE_ELEVENLABS=
# Pauses new uploads. Account deletion Storage cleanup still requires the separate destructive guard below.
NATIVE_MINUTE_DISABLE_STORAGE_UPLOADS=
# Alternate alias accepted by runtime/preflight; prefer the plural name above for existing deployments.
NATIVE_MINUTE_DISABLE_STORAGE_UPLOAD=
# Timing logs are enabled automatically outside production.
# In production, set to 1 only for an intentional short measurement window.
NATIVE_MINUTE_ENABLE_TIMING=0
# Destructive account deletion is off by default.
# Set to 1 only for an intentional support/admin cleanup run with a disposable proof first.
NATIVE_MINUTE_ENABLE_ACCOUNT_DELETION_DESTRUCTIVE=
VOICE_PROVIDER=mock
# AI script generation is off for beta unless explicitly enabled on the server.
NATIVE_MINUTE_ENABLE_AI_SCRIPT_GENERATION=0
# Script Studio provider defaults to mock; it is not called while the beta gate is off.
SCRIPT_GENERATION_PROVIDER=mock
TRANSCRIPTION_PROVIDER=mock
# Required only when SCRIPT_GENERATION_PROVIDER=openai, VOICE_PROVIDER=openai, or TRANSCRIPTION_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_VOICE_MODEL=gpt-4o-mini-tts
OPENAI_SCRIPT_GENERATION_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
PRONUNCIATION_PROVIDER=mock
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
E2E_TEST_SECRET=
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
